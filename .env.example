# Bale Self-Account Phone Number (International format)
BALE_PHONE=+989123456789

# Target Source Bale Channel (ID, Username, or Title)
SOURCE_BALE_CHANNEL=my_bale_channel

# Telegram Bot Token (obtained via @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyZ

# Telegram Target Channel ID (e.g. -1001234567890)
TELEGRAM_CHANNEL_ID=-1001234567890

# Optional Configurations
SESSION_DIR=./session_data
MEDIA_DIR=./temp_media
LOG_LEVEL=INFO
RECONNECT_DELAY=5